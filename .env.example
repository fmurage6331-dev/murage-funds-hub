# Murage Funds Hub - Environment Variables Template
# Copy to .env and fill in your Supabase project credentials

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional service role key for backend admin operations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Africa's Talking: SERVER/Edge Functions only. Never use a VITE_ prefix for secrets.
AFRICASTALKING_USERNAME="muragefoundation"
AFRICASTALKING_API_KEY="your-sandbox-api-key"
AFRICASTALKING_ENV="sandbox"
ADMIN_WHATSAPP_NUMBER="254182528510"
# Required for AT's unauthenticated webhook callback. Use a long random value.
AFRICASTALKING_WEBHOOK_SECRET="generate-a-random-secret-at-least-32-characters"
# Required only when AFRICASTALKING_ENV=live and sending WhatsApp messages:
# AFRICASTALKING_WHATSAPP_NUMBER="254711111111"

# Optional Resend API key for Edge Function email notifications
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Murage Foundation <notify@your-verified-domain.example>"
