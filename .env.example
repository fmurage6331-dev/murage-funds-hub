# Murage Funds Hub - Environment Variables Template
# Copy to .env and fill in your Supabase project credentials

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional service role key for backend admin operations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional Resend API key for Edge Function email notifications
# RESEND_API_KEY="re_..."

# Server/Edge Function ONLY. Never prefix these with VITE_ or expose them in the browser.
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your-sandbox-key"
AFRICASTALKING_ENV="sandbox" # sandbox | live
AFRICASTALKING_WEBHOOK_SECRET="generate-a-long-random-token"
# Registered AT WhatsApp sending number (not necessarily the admin's number).
AFRICASTALKING_WHATSAPP_NUMBER="+2547XXXXXXXX"
# Optional: AT-registered shortcode/alphanumeric SMS sender. Leave unset for default.
# AFRICASTALKING_SMS_SENDER_ID="your-sender"
ADMIN_WHATSAPP_NUMBER="254182528510"
